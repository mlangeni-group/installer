{
  "name": "machinjiri/installer",
  "description": "Installer for Machinjiri PHP Framework",
  "type": "composer-plugin",
  "license": "MIT",
  "version": "1.5.0",
  "authors": [
    {
      "name": "Precious Lyson",
      "email": "precious.lyson@gmail.com",
      "role": "Developer"
    },
    {
      "name": "Mlangeni Group",
      "email": "mlangenigroupqm@gmail.com",
      "role": "Owner"
    }
  ],
  "require": {
    "php": "^8.4",
    "composer-plugin-api": "^2.0",
    "composer-runtime-api": "^2.0",
    "symfony/console": "^8.1",
    "symfony/process": "^6.0 || ^7.0 || ^8.0",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-zip": "*",
    "ext-pdo": "*",
    "ext-tokenizer": "*",
    "ext-ctype": "*"
  },
  "require-dev": {
    "composer/composer": "^2.0",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Machinjiri\\Installer\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-text"
  },
  "extra": {
    "class": "Machinjiri\\Installer\\Plugin"
  },
  "bin": ["bin/machinjiri"],
  "minimum-stability": "stable",
  "prefer-stable": true
}
